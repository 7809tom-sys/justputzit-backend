# Copy to .env.staging and fill in STAGING values only. .env.staging is git-ignored.
# The migration scripts refuse to run unless MIGRATION_TARGET=staging and these values differ from .env.
MIGRATION_TARGET=staging

# Empty staging TiDB database (a separate cluster or database from production)
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/justputzit_staging?ssl={"minVersion":"TLSv1.2","rejectUnauthorized":true}

# A separate STAGING Supabase project
SUPABASE_URL=https://STAGING-REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLIC_BUCKET=site-public
SUPABASE_PRIVATE_BUCKET=member-private

# Deployed staging API (Railway) and its CRON_SECRET, used by the smoke test
STAGING_API_URL=https://STAGING-API.up.railway.app
CRON_SECRET=
