{
  "name": "justputzit-backend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:api": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "migration:run-all": "tsx migration/run-all.ts",
    "migration:wipe": "tsx migration/wipe-staging.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/supabase-js": "^2.118.0",
    "@trpc/server": "^11.6.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "jose": "6.1.0",
    "multer": "^2.2.0",
    "mysql2": "^3.15.0",
    "stripe": "^22.5.0",
    "superjson": "^1.13.3",
    "ws": "^8.21.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.7.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af"
}
