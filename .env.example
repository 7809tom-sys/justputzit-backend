# ===== SHARED / DATABASE =====
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@host:4000/justputzit?ssl={"minVersion":"TLSv1.2","rejectUnauthorized":true}

# ===== SUPABASE (Auth + Storage) =====
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ===== AI AND MAPS (server): Gemini and MapTiler =====
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash
GEMINI_MODEL=
MAPTILER_API_KEY=

# ===== ACCESS CONTROL / DEPLOYMENT (server) =====
CRON_SECRET=
# Comma-separated emails that get the admin role on sign-in
ADMIN_EMAILS=
# Comma-separated allowed browser origins, e.g. https://justputzit.com,https://app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ===== PASSKEYS (optional) =====
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ===== PAYMENTS / EMAIL / INTEGRATIONS (server) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
EVENTBRITE_API_KEY=
EVENTBRITE_TOKEN=
MEETUP_API_KEY=
CINCH_SEED_ID=
CINCH_CONNECT_KEY=

# The server also reads the public site URL (invite links).
VITE_SITE_URL=
